[node name="IncidentObjective" type="Label" parent="Margin/Layout"]
layout_mode = 2
text = "Shift incident objective"
autowrap_mode = 3

[node name="Alarms" type="Label" parent="Margin/Layout"]
layout_mode = 2
text = "Active alarms\nNone"
