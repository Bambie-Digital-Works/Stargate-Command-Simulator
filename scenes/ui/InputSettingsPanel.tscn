[node name="Status" type="Label" parent="Margin/Layout"]
layout_mode = 2
text = "Select a binding to change it."

[node name="ActionScroll" type="ScrollContainer" parent="Margin/Layout"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="ActionRows" type="VBoxContainer" parent="Margin/Layout/ActionScroll"]
