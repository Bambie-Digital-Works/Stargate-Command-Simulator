[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://src/Presentation/MissionControl.cs" id="1_script"]

[node name="MissionControl" type="PanelContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
script = ExtResource("1_script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 20

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Heading" type="Label" parent="Margin/Layout"]
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "Mission Control"

[node name="Description" type="Label" parent="Margin/Layout"]
layout_mode = 2
text = "Select a mission, manage field progress, and authorize return."
autowrap_mode = 3

[node name="MissionSelector" type="OptionButton" parent="Margin/Layout"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Summary" type="Label" parent="Margin/Layout"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "No mission selected"

[node name="Objective" type="Label" parent="Margin/Layout"]
layout_mode = 2
text = "Mission objective"
autowrap_mode = 3

[node name="Progress" type="Label" parent="Margin/Layout"]
layout_mode = 2
text = "Field progress: 0%"

[node name="Status" type="Label" parent="Margin/Layout"]
layout_mode = 2
theme_override_colors/font_color = Color(0.980392, 0.807843, 0.376471, 1)
text = "Mission Board ready."
autowrap_mode = 3

[node name="Spacer" type="Control" parent="Margin/Layout"]
layout_mode = 2
size_flags_vertical = 3

[node name="Actions" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="StartButton" type="Button" parent="Margin/Layout/Actions"]
layout_mode = 2
text = "Start mission"

[node name="AdvanceButton" type="Button" parent="Margin/Layout/Actions"]
layout_mode = 2
text = "Advance field work"

[node name="ReturnButton" type="Button" parent="Margin/Layout/Actions"]
layout_mode = 2
text = "Authorize return"

[node name="AbortButton" type="Button" parent="Margin/Layout/Actions"]
layout_mode = 2
text = "Emergency abort"

[node name="BackButton" type="Button" parent="Margin/Layout/Actions"]
layout_mode = 2
text = "Back to Operations Board"
