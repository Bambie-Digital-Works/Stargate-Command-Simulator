[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://src/Presentation/ShiftReview.cs" id="1_script"]

[node name="ShiftReview" type="PanelContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
script = ExtResource("1_script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 16

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Heading" type="Label" parent="Margin/Layout"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Shift Review"

[node name="Outcome" type="Label" parent="Margin/Layout"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Outcome: —"

[node name="Rule" type="Label" parent="Margin/Layout"]
layout_mode = 2
text = "Category rule"
autowrap_mode = 3

[node name="Score" type="Label" parent="Margin/Layout"]
layout_mode = 2
text = "Facts: 0"

[node name="Timeline" type="Label" parent="Margin/Layout"]
layout_mode = 2
text = "Timeline"
autowrap_mode = 3

[node name="Consequences" type="Label" parent="Margin/Layout"]
layout_mode = 2
text = "Consequences"
autowrap_mode = 3

[node name="Feedback" type="Label" parent="Margin/Layout"]
layout_mode = 2
text = "Review chronological facts and recorded consequences."
autowrap_mode = 3

[node name="Actions" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="NextShiftButton" type="Button" parent="Margin/Layout/Actions"]
layout_mode = 2
text = "Begin next shift"
