[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://src/Presentation/SystemsBoard.cs" id="1_script"]

[node name="SystemsBoard" type="PanelContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
script = ExtResource("1_script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 20

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Heading" type="Label" parent="Margin/Layout"]
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "Systems Board"

[node name="Description" type="Label" parent="Margin/Layout"]
layout_mode = 2
text = "Monitor facility reserves, isolate faults, and authorize repair actions."
autowrap_mode = 3

[node name="ResourceGrid" type="GridContainer" parent="Margin/Layout"]
layout_mode = 2
theme_override_constants/h_separation = 24
theme_override_constants/v_separation = 10
columns = 2

[node name="PowerHeading" type="Label" parent="Margin/Layout/ResourceGrid"]
layout_mode = 2
text = "Power"

[node name="PowerValue" type="Label" parent="Margin/Layout/ResourceGrid"]
layout_mode = 2
size_flags_horizontal = 3
text = "Loading"

[node name="CoolingHeading" type="Label" parent="Margin/Layout/ResourceGrid"]
layout_mode = 2
text = "Cooling"

[node name="CoolingValue" type="Label" parent="Margin/Layout/ResourceGrid"]
layout_mode = 2
size_flags_horizontal = 3
text = "Loading"

[node name="FaultStatus" type="Label" parent="Margin/Layout"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Cooling status: Nominal"

[node name="RepairGuidance" type="Label" parent="Margin/Layout"]
layout_mode = 2
text = "No repair action required."
autowrap_mode = 3

[node name="AlarmHistory" type="Label" parent="Margin/Layout"]
layout_mode = 2
size_flags_vertical = 3
text = "Alarm history\nNo alarms recorded this shift."
autowrap_mode = 3

[node name="Actions" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="RepairButton" type="Button" parent="Margin/Layout/Actions"]
layout_mode = 2
text = "Run diagnostics and clear cooling fault"

[node name="BackButton" type="Button" parent="Margin/Layout/Actions"]
layout_mode = 2
text = "Back to Operations Board"
