<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FacilityCommand</RootNamespace>
    <AssemblyName>FacilityCommand</AssemblyName>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="'$(Configuration)' == 'ExportRelease'">$(BaseIntermediateOutputPath)export-packages.lock.json</NuGetLockFilePath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">dev</VersionSuffix>
    <BuildChannel Condition="'$(BuildChannel)' == ''">development</BuildChannel>
    <BuildId Condition="'$(BuildId)' == ''">local</BuildId>
    <CommitSha Condition="'$(CommitSha)' == ''">unknown</CommitSha>
    <ContentSchemaVersion Condition="'$(ContentSchemaVersion)' == ''">1</ContentSchemaVersion>
    <SaveSchemaVersion Condition="'$(SaveSchemaVersion)' == ''">2</SaveSchemaVersion>
    <BuildUtc Condition="'$(BuildUtc)' == ''">1970-01-01T00:00:00Z</BuildUtc>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs;tools/**/*.cs" />
    <AssemblyMetadata Include="BuildChannel" Value="$(BuildChannel)" />
    <AssemblyMetadata Include="BuildId" Value="$(BuildId)" />
    <AssemblyMetadata Include="CommitSha" Value="$(CommitSha)" />
    <AssemblyMetadata Include="ContentSchemaVersion" Value="$(ContentSchemaVersion)" />
    <AssemblyMetadata Include="SaveSchemaVersion" Value="$(SaveSchemaVersion)" />
    <AssemblyMetadata Include="BuildUtc" Value="$(BuildUtc)" />
  </ItemGroup>
</Project>

