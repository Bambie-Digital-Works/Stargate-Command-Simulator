; Engine configuration file.
; Prefer editing through the Godot editor unless a reviewable text change is needed.
; Format:
;   [section]
;   param=value

config_version=5

[application]

config/name="Stargate Command Simulator"
config/description="Original command-centre simulation (working title)"
run/main_scene="res://scenes/boot/Boot.tscn"
config/features=PackedStringArray("4.7", "C#")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="FacilityCommand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
